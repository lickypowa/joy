{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
      "@joy-core/*": ["./joy-core/src/*"]
    }
  },
  "include": ["app/**/*", "src/**/*", "modules/**/*"],
  "exclude": ["joy-core", "node_modules", "dist"]
}
