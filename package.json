{
  "name": "joy-assistant",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "node scripts/patch-llama-rn-bridge.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "expo": "~58.0.11",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.11",
    "expo-router": "~58.0.26",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.3",
    "llama.rn": "0.12.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "~24.7.2",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "prettier": "^2.8.3",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "llama.rn@0.12.9": true
  },
  "overrides": {
    "@react-native/virtualized-lists": "0.88.1"
  }
}
